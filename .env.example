# Copy to .env and fill in. .env is gitignored.
PORT=3001
CAST_RECEIVER_APP_ID=
PUBLIC_BASE_URL=http://localhost:5173
QUESTION_BANK_PATH=question-bank/bank.json

# --- scripts/questionbank/build_bank.py only (the Node server ignores these) ---
# Google/YouTube Data API v3 key. Optional LEGACY pre-filter that drops songs
# with embedding disabled — no longer needed (the game plays songs via native
# YouTube Music links, which have no embed restrictions) and only runs when you
# pass --youtube-api-key explicitly. The Node server never reads it.
YOUTUBE_API_KEY=

# Anthropic API key + model — enables AI-generated setlist categories instead of
# one category per playlist. Same names/default as the pinpoint sibling project.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
