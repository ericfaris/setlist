# Copy to .env and fill in. .env is gitignored.
PORT=3001
CAST_RECEIVER_APP_ID=
PUBLIC_BASE_URL=http://localhost:5173
QUESTION_BANK_PATH=question-bank/bank.json
CLIP_START_SECONDS=30
CLIP_DURATION_SECONDS=20

# --- scripts/questionbank/build_bank.py only (not read by the Node server) ---
# Google/YouTube Data API v3 key — enables the embeddable pre-check so songs
# with embedding disabled never reach the board.
YOUTUBE_API_KEY=
# Anthropic API key + model — enables AI-generated board categories instead of
# one category per playlist. Same names/default as the pinpoint sibling project.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
