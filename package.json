{
  "name": "setlist",
  "private": true,
  "version": "0.2.0",
  "description": "Real-time multiplayer music trivia — Jeopardy-style, cast to your TV",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "build": "npm run build -w @setlist/shared && npm run build -w @setlist/client && npm run build -w @setlist/server",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w @setlist/server",
    "dev:client": "npm run dev -w @setlist/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
